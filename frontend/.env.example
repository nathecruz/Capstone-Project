# Public values only. Never put private API keys in the Expo app.
EXPO_PUBLIC_API_URL=https://your-production-api.example.com
# Optional: public support inbox shown by Help & Support > Contact Support (otherwise the in-app report form is used).
EXPO_PUBLIC_SUPPORT_EMAIL=
# Optional (not used for sign-in): Neon Auth client URL.
EXPO_PUBLIC_AUTH_URL=
EXPO_PUBLIC_AI_API_URL=https://your-production-api.example.com
 