# Neon PostgreSQL connection string (the same database the HabitAI app backend uses).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/habit_tracker_db?sslmode=require&channel_binding=require
DATABASE_POOL_MAX=5

# Port for the Admin Panel API. In production PORT is also honoured when API_PORT is unset.
API_PORT=4000

# Time zone used to bucket days/weeks in analytics.
APP_TIME_ZONE=Asia/Manila
APP_NAME=HabitAI

# Admin session length in hours.
ADMIN_SESSION_HOURS=12

# Only needed when the client is served from another origin.
ALLOWED_ORIGINS=http://localhost:5174

# Set to true behind a reverse proxy (Render, Nginx) so rate limiting sees real client IPs.
TRUST_PROXY=false

# Class Pulse (faculty dashboard), optional. The ML service gives each student's dropout risk
# (only counts are shown) and Groq writes the AI class summary. On Render these come from the
# habitai-ml and habitai-backend services automatically (see render.yaml).
ML_SERVICE_URL=
ML_SERVICE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
