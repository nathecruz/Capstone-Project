# Root development defaults
# `npm run dev` supplies this development-only key automatically.
NODE_ENV=development
ML_SERVICE_API_KEY=replace-with-a-long-random-secret

# Backend
PORT=8787
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/habitai?sslmode=require
DATABASE_POOL_MAX=10
# New accounts must confirm their email before using the app (skipped automatically when SMTP is not configured).
REQUIRE_EMAIL_VERIFICATION=true
# Optional: Postgres URL for the integration test (a Neon branch is safest; tests use a private schema).
TEST_DATABASE_URL=
BACKUP_DIR=./backend/data/backups
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:19080,http://localhost:8081
ML_SERVICE_URL=http://localhost:8000
EXTERNAL_REQUEST_TIMEOUT_MS=15000

# Optional Gemini backend integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Legacy Gmail names are also supported.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Frontend Expo public configuration
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_AI_API_URL=http://localhost:8787
# Optional: public support inbox shown by Help & Support > Contact Support (otherwise the in-app report form is used).
EXPO_PUBLIC_SUPPORT_EMAIL=
# Optional (not used for sign-in): Neon Auth client URL.
EXPO_PUBLIC_AUTH_URL=

# ML service
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
