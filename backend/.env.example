PORT=8787
DATABASE_PATH=./data/habitai.sqlite
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/habitai?sslmode=verify-full
DATABASE_POOL_MAX=10
BACKUP_DIR=./data/backups
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:19080,http://localhost:8081

# Gmail SMTP settings for password reset emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-email@example.com
SUPPORT_EMAIL=

# Legacy Gmail names are still supported when the SMTP settings above are empty.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Gemini AI settings
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=replace-with-a-long-random-secret
EXTERNAL_REQUEST_TIMEOUT_MS=15000
