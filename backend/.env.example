PORT=8787
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/habitai?sslmode=verify-full
DATABASE_POOL_MAX=10
# New accounts must confirm their email before using the app (skipped automatically when email is not configured).
REQUIRE_EMAIL_VERIFICATION=true
# Optional: Postgres URL for the integration test (a Neon branch is safest; tests use a private schema).
TEST_DATABASE_URL=
BACKUP_DIR=./data/backups
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:19080,http://localhost:8081

# Email for verification codes, password resets and support reports. Two options:
# 1) Brevo HTTPS API (needed on Render's free plan, which blocks SMTP ports). Free: 300 emails/day.
#    brevo.com -> SMTP & API -> API keys; EMAIL_FROM must be a sender verified in Brevo (Senders).
BREVO_API_KEY=
EMAIL_FROM=
# 2) SMTP, e.g. Gmail with a 16-character App Password (used when BREVO_API_KEY is empty).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-email@example.com
SUPPORT_EMAIL=

# Legacy Gmail names are still supported when the SMTP settings above are empty.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional AI (Groq) settings: console.groq.com -> API Keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=replace-with-a-long-random-secret
EXTERNAL_REQUEST_TIMEOUT_MS=15000
